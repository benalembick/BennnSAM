{
  "name": "@bennnsam/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && esbuild src/index.ts --bundle --platform=node --target=node18 --outfile=dist/server.js --format=cjs --log-level=info",
    "start": "node dist/server.js",
    "start:ts": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:cloudability": "tsx src/cloudabilityEngine.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.87.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "morgan": "^1.10.1",
    "nanoid": "^5.1.6",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.0.3",
    "esbuild": "^0.25.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
