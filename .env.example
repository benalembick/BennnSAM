# BennnSam local development
NODE_ENV=development

# API
API_PORT=4100
CORS_ORIGIN=http://localhost:5172
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
BENNSAM_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
BENNSAM_DEFAULT_TENANT_NAME=Northstar Manufacturing
BENNSAM_DEFAULT_TENANT_SLUG=northstar

# Web
VITE_API_URL=http://localhost:4100/api

# Set VITE_DEMO_MODE=true to run entirely on built-in mock data (no Supabase needed).
# Remove or set to false when using a real Supabase project.
VITE_DEMO_MODE=true

# Only needed when VITE_DEMO_MODE is false (live Supabase mode).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: when omitted, the AI report assistant uses deterministic safe templates.
OPENAI_API_KEY=

# Invite redirect URL — where users land after clicking "Accept invitation" in their email.
# Must be added to Supabase → Authentication → URL Configuration → Redirect URLs.
# Defaults to VITE_API_URL with /api stripped, or http://localhost:5172.
INVITE_REDIRECT_URL=http://localhost:5172

# SMTP — required for branded BennnSAM invite emails.
# If omitted, Supabase's built-in email is used (generic branding, correct redirect URL).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=BennnSAM <noreply@bennnsam.com>
