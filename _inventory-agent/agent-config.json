{
  "Api": {
    "PrimaryEndpoint": "http://localhost:4100",
    "BackupEndpoint": "",
    "InventoryPath": "/v1/agents/{deviceId}/inventory",
    "CertificatePins": [],
    "TimeoutSeconds": 60
  },
  "Collection": {
    "EnabledModules": [
      "system",
      "software",
      "hardware",
      "licensing",
      "compliance"
    ],
    "CacheTtlHours": 6,
    "MaxParallelism": 4,
    "ExcludePublishers": [],
    "ExcludeApplications": [],
    "ExcludeProcessPaths": [
      "\\Windows\\Temp\\",
      "\\AppData\\Local\\Temp\\"
    ]
  },
  "Upload": {
    "IntervalHours": 24,
    "MaxQueueAgeDays": 7,
    "RequireUserConfirmation": true,
    "AllowUploadWithoutPrompt": false
  },
  "Logging": {
    "RetentionDays": 30,
    "MaxFileMb": 10
  }
}
